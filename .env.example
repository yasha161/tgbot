# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Cloudflare AI Gateway URL for Edge Caching & Rate Protection
# Format: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/google-ai-studio
# CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/.../google-ai-studio
